DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional for legacy/local token authentication. New Vercel projects use OIDC.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_SECRET_KEY=sk_test_example
# Keep this server-only. Do not add it to NEXT_PUBLIC_ variables or the Chrome extension.
OPENAI_API_KEY=sk-proj_example
# Optional model override. MeritOS defaults to the frontier gpt-5.6-sol model.
# OPENAI_MODEL=gpt-5.6-sol
# Optional per-workload overrides:
# OPENAI_EXTRACTION_MODEL=gpt-5.6-sol
# Optional fine-tuned extraction student. This takes priority over OPENAI_EXTRACTION_MODEL.
# OPENAI_EXTRACTION_FINE_TUNED_MODEL=ft:gpt-4o-mini-2024-07-18:org:meritos-resume-extractor:id
# Fine-tuning base model; GPT-5.6 Sol does not currently support fine-tuning.
# OPENAI_FINE_TUNE_BASE_MODEL=gpt-4o-mini-2024-07-18
# OPENAI_PROFILE_MODEL=gpt-5.6-sol
# OPENAI_DRAFT_MODEL=gpt-5.6-sol
# OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
